# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Cal.com booking embed on /contact (enabled by default; set to false to hide)
# NEXT_PUBLIC_SCHEDULING_ENABLED=true
# Cal.com link in "username/event-slug" form
# NEXT_PUBLIC_CAL_LINK=haktan-tuna-yılar-5srfpw/discovery-call

# Where career applications are delivered (default: info@keningfordpartners.com)
CAREERS_APPLICATION_TO=info@keningfordpartners.com

# EnergyCite onboarding form — submissions emailed via Resend
# ENERGYCITE_FORM_TO=info@keningfordpartners.com
# ENERGYCITE_FORM_FROM=Keningford Partners <onboarding@yourdomain.com>

# Sender — use a verified domain in production, e.g.:
# CAREERS_FROM_EMAIL=Keningford Partners <careers@keningfordpartners.com>
# For Resend testing without a domain, onboarding@resend.dev only delivers to your Resend account email.
CAREERS_FROM_EMAIL=Keningford Careers <onboarding@resend.dev>
